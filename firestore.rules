rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /rooms/{roomId} {

      function signedIn() { return request.auth != null; }
      function me() { return request.auth.uid; }
      function before() { return resource.data; }
      function after() { return request.resource.data; }
      function isHost() { return me() == before().hostId; }

      // La sala no cambia de anfitrion ni de fecha, y solo tiene estos campos.
      function roomShape() {
        return after().keys().hasOnly(['status', 'hostId', 'seats', 'uids', 'createdAt', 'gameState'])
          && after().hostId == before().hostId
          && after().createdAt == before().createdAt
          && after().seats is list && after().seats.size() <= 5
          && after().uids is list;
      }

      // Un jugador nuevo se sienta al final de la lista, con su propio uid.
      function isJoining() {
        return before().status == 'lobby' && after().status == 'lobby'
          && !(me() in before().uids)
          && before().seats.size() < 5
          && after().seats.size() == before().seats.size() + 1
          && after().seats.hasAll(before().seats)
          && after().seats[before().seats.size()].clientId == me()
          && after().seats[before().seats.size()].isBot == false
          && after().uids == before().uids.concat([me()])
          && !('gameState' in after());
      }

      // Un jugador que no es el anfitrion sale de la sala antes de empezar.
      function isLeaving() {
        return before().status == 'lobby' && after().status == 'lobby'
          && !isHost()
          && me() in before().uids
          && after().uids == before().uids.removeAll([me()])
          && after().seats.size() == before().seats.size() - 1
          && before().seats.hasAll(after().seats)
          && !('gameState' in after());
      }

      // El anfitrion gestiona la sala en el lobby (CPUs, expulsar, empezar).
      function isHostInLobby() {
        return isHost() && before().status == 'lobby'
          && after().status in ['lobby', 'playing']
          && (after().status == 'lobby' || after().gameState is map);
      }

      // Durante la partida solo escribe quien tiene el turno; el anfitrion mueve a las CPUs.
      function isPlayerMove() {
        return before().status == 'playing'
          && after().status in ['playing', 'over']
          && after().seats == before().seats
          && after().uids == before().uids
          && after().gameState is map
          && after().gameState.players.size() == before().gameState.players.size()
          && (
            before().gameState.players[before().gameState.turn].id == me()
            || (isHost() && before().gameState.players[before().gameState.turn].isBot == true)
          );
      }

      // Guante de Latex: la victima (o el anfitrion, por una CPU) descarta su mano y se quita de la lista.
      // La ultima victima pasa ademas el turno que el Guante dejo pendiente (solo a la posicion siguiente).
      function isGloveResponse() {
        return before().status == 'playing' && after().status == 'playing'
          && after().seats == before().seats
          && after().uids == before().uids
          && after().gameState is map && before().gameState is map
          && after().gameState.diff(before().gameState).affectedKeys().hasOnly(['discard', 'gloveFor', 'handCounts', 'turn', 'turnCount'])
          && after().gameState.gloveFor.size() < before().gameState.gloveFor.size()
          && (after().gameState.turn == before().gameState.turn
              || (after().gameState.gloveFor.size() == 0
                  && after().gameState.turn == (before().gameState.turn + 1) % before().gameState.players.size()))
          && (me() in before().gameState.gloveFor
              || (isHost() && before().gameState.gloveFor.size() > 0));
      }

      // Solo se puede abrir una sala concreta si se conoce su codigo; no se pueden listar.
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn()
        && roomId.matches('^[A-HJ-NP-Z2-9]{4}$')
        && after().keys().hasOnly(['status', 'hostId', 'seats', 'uids', 'createdAt'])
        && after().status == 'lobby'
        && after().hostId == me()
        && after().uids == [me()]
        && after().seats.size() == 1
        && after().seats[0].clientId == me()
        && after().seats[0].isBot == false;

      allow update: if signedIn() && roomShape()
        && (isJoining() || isLeaving() || isHostInLobby() || isPlayerMove() || isGloveResponse());

      // Solo el anfitrion puede cerrar la sala, empezada o no.
      allow delete: if signedIn() && isHost();

      // Manos privadas: rooms/{sala}/hands/{uid}. Solo las lee su propietario (y el anfitrion, las de las CPUs).
      match /hands/{ownerId} {
        function room() { return get(/databases/$(database)/documents/rooms/$(roomId)).data; }
        function isRoomHost() { return request.auth.uid == room().hostId; }
        function isBotHand() { return ownerId.matches('^bot_.*'); }
        function turnPlayerId() { return room().gameState.players[room().gameState.turn].id; }
        function inPlay() { return room().status == 'playing'; }

        allow read: if signedIn()
          && (request.auth.uid == ownerId || (isBotHand() && isRoomHost()));

        allow create, update: if signedIn()
          && request.resource.data.keys().hasOnly(['cards'])
          && request.resource.data.cards is list
          && request.resource.data.cards.size() <= 3
          && (
            // reparto inicial, lo hace el anfitrion al empezar
            (isRoomHost() && room().status == 'lobby')
            // robar o jugar en mi turno
            || (inPlay() && request.auth.uid == ownerId && turnPlayerId() == ownerId)
            // descartar la mano por un Guante de Latex
            || (inPlay() && request.auth.uid == ownerId
                && request.resource.data.cards.size() == 0
                && ownerId in room().gameState.gloveFor)
            // turno o guante de una CPU, gestionado por el anfitrion
            || (inPlay() && isBotHand() && isRoomHost()
                && (turnPlayerId() == ownerId || ownerId in room().gameState.gloveFor))
          );

        allow delete: if signedIn() && (request.auth.uid == ownerId || isRoomHost());
      }
    }
  }
}
